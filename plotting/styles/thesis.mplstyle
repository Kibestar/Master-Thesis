# Shared palette: keep these hex values aligned with latex/thesis-colors.sty.

# Figure size and export quality
figure.figsize: 6.69, 3.5
figure.dpi: 400
savefig.dpi: 400
savefig.bbox: tight

# Layout
figure.constrained_layout.use: True
axes.labelpad: 6

# Typography: 11 pt body/labels, as in the thesis document.
font.size: 11
axes.labelsize: 11
axes.titlesize: 11
xtick.labelsize: 9.5
ytick.labelsize: 9.5
legend.fontsize: 11
figure.titlesize: 14

# TU Delft-inspired thesis palette
axes.prop_cycle: cycler(color=["#00A6D6", "#003082", "#00B5E2", "#000000"])

# Standard line and grid styling
lines.linewidth: 2
grid.linestyle: --
