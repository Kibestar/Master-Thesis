  number = {7},
  pages = {511--515},
  doi = {10.2320/matertrans1960.25.511},
  abstract = {Characteristics of superconductivity in Nb--Ti alloys (Nb-41--55 mass\%Ti) are studied through electrical resistivity measurements. The superconducting transition temperature Tc and the electron-phonon resistivity at 273 K, {$\rho$}ep (273 K), are obtained with the measurements. From the experimental values of Tc, the electron-phonon coupling parameter {$\lambda$} is determined as a function of concentration. The density of states at Fermi level N(Ef) is estimated by using the relation between the values of {$\lambda$} obtained here and the coefficient of electronic specific heat {$\gamma$}. The results lead to a conclusion that the increase of Tc is mainly caused by the rise of N(Ef) with concentration. The electron-phonon coupling parameter in electronic transport {$\lambda$}tr is also determined from the experimental values of {$\rho$}ep (273 K), and compared with {$\lambda$}.},
  keywords = {critical temperature,electrical resistivity,electron-phonon coupling,niobium-titanium alloy,superconductor},
  file = {/Users/felixvossbrink/Zotero/storage/VRQKPDFM/Electrical Resistivity of Nb–Ti Superconductors.pdf;/Users/felixvossbrink/Zotero/storage/Y5Z9ZCXX/Takei - 1984 - Electrical Resistivity of Nb–Ti Superconductors.pdf;/Users/felixvossbrink/Zotero/storage/4N77ICD2/ja.html}
}

@article{tsukamotoIdentificationQuenchOrigins1981,
  title = {Identification of Quench Origins in a Superconductor with Acoustic Emission and Voltage Measurements},
  author = {Tsukamoto, O. and Maguire, J. F. and Bobrov, E. S. and Iwasa, Y.},
  year = 1981,
