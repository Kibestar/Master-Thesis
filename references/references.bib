@article{benkheiraHeatTransferCharacteristics2007,
  title = {Heat Transfer Characteristics of Two-Phase {{He I}} (4.2 ~ {{K}}) Thermosiphon Flow},
  author = {Benkheira, L. and Baudouy, B. and Souhar, M.},
  year = 2007,
